	}
	pcall(function()
		writefile(CONFIG_FILE, HS:JSONEncode(data))
	end)
	savePlaylist()
end

local function loadPlaylist()
	if not readfile or not isfile or not isfile(PLAYLIST_FILE) then return end
	local ok, raw = pcall(function() return readfile(PLAYLIST_FILE) end)
	if not ok or not raw or raw == "" then return end
	local ok2, decoded = pcall(function() return HS:JSONDecode(raw) end)
	if ok2 and type(decoded) == "table" and #decoded > 0 then
		local broken = {
			["rbxassetid://1845554044"] = true,
			["rbxassetid://1838457585"] = true,
			["rbxassetid://1846523151"] = true,
		}
		local hasBroken = false
		for _, t in ipairs(decoded) do
			if t and broken[tostring(t.id)] then hasBroken = true break end
		end
		if not hasBroken then
			Playlist = decoded
		end
	end
end

local function loadAllConfig()
	loadPlaylist()
	if not readfile or not isfile or not isfile(CONFIG_FILE) then return end
	local ok, raw = pcall(function() return readfile(CONFIG_FILE) end)
	if not ok or not raw or raw == "" then return end
	local ok2, data = pcall(function() return HS:JSONDecode(raw) end)
	if not ok2 or type(data) ~= "table" then return end

	if type(data.playlist) == "table" and #data.playlist > 0 then
		local broken = {
			["rbxassetid://1845554044"] = true,
			["rbxassetid://1838457585"] = true,
			["rbxassetid://1846523151"] = true,
		}
		local hasBroken = false
		for _, t in ipairs(data.playlist) do
			if t and broken[tostring(t.id)] then hasBroken = true break end
		end
		if not hasBroken then Playlist = data.playlist end
	end
	if type(data.musicVolume) == "number" then
		musicVolume = math.clamp(data.musicVolume, 0, 5)
	end
	if type(data.currentTrack) == "number" then
		currentTrack = math.clamp(data.currentTrack, 1, math.max(1, #Playlist))
	end
	if type(data.bgIdx) == "number" then bgIdx = data.bgIdx end
	if type(data.strokeIdx) == "number" then strokeIdx = data.strokeIdx end
	if type(data.textIdx) == "number" then textIdx = data.textIdx end
	if type(data.fontIdx) == "number" then fontIdx = data.fontIdx end
	if type(data.strokeThickIdx) == "number" then strokeThickIdx = data.strokeThickIdx end
	if type(data.textStrokeEnabled) == "boolean" then textStrokeEnabled = data.textStrokeEnabled end

	if type(data.BgColor) == "table" then
		STYLES.BgColor = Color3.new(data.BgColor[1] or 0, data.BgColor[2] or 0, data.BgColor[3] or 0)
	end
	if type(data.CardColor) == "table" then
		STYLES.CardColor = Color3.new(data.CardColor[1] or 0, data.CardColor[2] or 0, data.CardColor[3] or 0)
	end
	if type(data.StrokeColor) == "table" then
		STYLES.StrokeColor = Color3.new(data.StrokeColor[1] or 0, data.StrokeColor[2] or 0, data.StrokeColor[3] or 0)
	end
	if type(data.TextColor) == "table" then
		STYLES.TextColor = Color3.new(data.TextColor[1] or 1, data.TextColor[2] or 1, data.TextColor[3] or 1)
	end

	currentFont = ThemeOptions.Fonts[math.clamp(fontIdx, 1, #ThemeOptions.Fonts)]
	currentStrokeThick = ThemeOptions.StrokeThick[math.clamp(strokeThickIdx, 1, #ThemeOptions.StrokeThick)]
end

