musicSound.Looped = false
musicSound.Parent = SoundService

local playBtn -- declarado cedo para as funções usarem

local function refreshPlayBtn()
	if not playBtn then return end
	if isPlaying then
		playBtn.Text = "⏸ PAUSE"
		playBtn.BackgroundColor3 = STYLES.SelectNeon
	else
		playBtn.Text = "▶ PLAY"
		playBtn.BackgroundColor3 = STYLES.GreenColor
	end
end

local function loadTrack(index, forceRestart)
	if #Playlist == 0 then return "—" end
	if index < 1 then index = #Playlist end
	if index > #Playlist then index = 1 end
	currentTrack = index
	local track = Playlist[currentTrack]
	if track then
		-- só troca SoundId se for música diferente (evita reiniciar no resume)
		local newId = track.id
		if not string.find(newId, "rbxassetid://") then
			newId = "rbxassetid://" .. tostring(newId)
		end
		if forceRestart or musicSound.SoundId ~= newId then
			musicSound.SoundId = newId
			wasPaused = false
		end
		return track.name
	end
	return "—"
end

local pausedTime = 0 -- guarda posição ao pausar

local function playMusic()
	if #Playlist == 0 then return end
	local track = Playlist[currentTrack]
	if not track then return end

	local newId = track.id
	if not string.find(tostring(newId), "rbxassetid://") then
		newId = "rbxassetid://" .. tostring(newId)
	end

	if musicSound.SoundId ~= newId then
		musicSound.SoundId = newId
		pausedTime = 0
		wasPaused = false
	end

	-- Resume manual pelo TimePosition (mais confiável que :Resume())
	if wasPaused and pausedTime > 0 then
		musicSound.TimePosition = pausedTime
	end

	musicSound:Play()
	wasPaused = false
	isPlaying = true
	refreshPlayBtn()
end

local function pauseMusic()
	if musicSound.IsPlaying or musicSound.Playing then
		pausedTime = musicSound.TimePosition
		musicSound:Pause()
		-- fallback se Pause não segurar
		if musicSound.IsPlaying then
			musicSound:Stop()
			-- TimePosition já foi salvo
		end
		wasPaused = true
	end
	isPlaying = false
	refreshPlayBtn()
end

local function stopMusic()
	musicSound:Stop()
	pausedTime = 0
	wasPaused = false
	isPlaying = false
	refreshPlayBtn()
end

local function nextTrack()
	wasPaused = false
	pausedTime = 0
	loadTrack(currentTrack + 1, true)
	if isPlaying then
		playMusic()
	end
end

local function prevTrack()
	wasPaused = false
	pausedTime = 0
	loadTrack(currentTrack - 1, true)
	if isPlaying then
		playMusic()
	end
end

musicSound.Ended:Connect(function()
	wasPaused = false
	nextTrack()
	playMusic()
end)

