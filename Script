local pendingDeleteIndex = nil

local function openConfirmDelete(index)
	if not Playlist[index] then return end
	pendingDeleteIndex = index
	local nome = Playlist[index].name or ("#" .. index)
	confirmLbl.Text = 'Excluir "' .. nome .. '"?'
	confirmFrame.Visible = true
end

local function closeConfirmDelete()
	pendingDeleteIndex = nil
	confirmFrame.Visible = false
end

confirmNo.MouseButton1Click:Connect(closeConfirmDelete)

confirmYes.MouseButton1Click:Connect(function()
	if not pendingDeleteIndex or not Playlist[pendingDeleteIndex] then
		closeConfirmDelete()
		return
	end
	local idx = pendingDeleteIndex
	closeConfirmDelete()
	table.remove(Playlist, idx)
	if currentTrack > #Playlist then currentTrack = math.max(1, #Playlist) end
	if currentTrack == idx or currentTrack > #Playlist then
		wasPaused = false
		stopMusic()
		if #Playlist > 0 then loadTrack(currentTrack, true) end
	elseif currentTrack > idx then
		currentTrack = currentTrack - 1
	end
	saveAllConfig()
	refreshTrackName()
	if renderPlaylist then renderPlaylist() end
end)

makeAddBtn("❌ DEL", 0.68, 0.32, STYLES.RedColor, function()
	if #Playlist == 0 then return end
	openConfirmDelete(currentTrack)
end)

