makeAddBtn("➕ ADD", 0, 0.32, STYLES.GreenColor, function()
	local rawId = idBox.Text:gsub("%s+", "")
	local nome = nameBox.Text ~= "" and nameBox.Text or ("Música " .. (#Playlist + 1))
	if rawId == "" then
		idBox.Text = ""
		idBox.PlaceholderText = "⚠️ Cole o ID!"
		task.wait(1.2)
		idBox.PlaceholderText = "ID da música (só números)"
		return
	end
	-- limpa se veio com rbxassetid://
	rawId = rawId:gsub("rbxassetid://", "")
	table.insert(Playlist, { id = "rbxassetid://" .. rawId, name = nome })
	saveAllConfig()
	idBox.Text = ""
	nameBox.Text = ""
	if renderPlaylist then renderPlaylist() end
	refreshTrackName()
end)

