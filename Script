applyStyle(playlistScroll, 4, true)

local plLayout = Instance.new("UIListLayout")
plLayout.Padding = UDim.new(0, 2)
plLayout.Parent = playlistScroll
plLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
	playlistScroll.CanvasSize = UDim2.new(0, 0, 0, plLayout.AbsoluteContentSize.Y + 4)
end)

renderPlaylist = function()
	for _, c in ipairs(playlistScroll:GetChildren()) do
		if not c:IsA("UIListLayout") then c:Destroy() end
	end
	for i, track in ipairs(Playlist) do
		local btn = Instance.new("TextButton")
		btn.Text = (i == currentTrack and "▶ " or "  ") .. track.name
		btn.Size = UDim2.new(1, -4, 0, 14)
		btn.BackgroundColor3 = (i == currentTrack) and STYLES.AccentColor or STYLES.CardColor
		btn.TextColor3 = STYLES.TextColor
		btn.Font = Enum.Font.SourceSansBold
		btn.TextSize = 8
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.Parent = playlistScroll
		applyStyle(btn, 2, false)
		local p = Instance.new("UIPadding")
		p.PaddingLeft = UDim.new(0, 4)
		p.Parent = btn
		btn.MouseButton1Click:Connect(function()
			wasPaused = false
			loadTrack(i, true)
			playMusic()
			refreshTrackName()
			renderPlaylist()
		end)
	end
end

