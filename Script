local CONTENT_WIDTH, BTN_H, BTN_H_SM, PAD_Y = 0.90, 20, 17, 3

local function applyStyle(inst, cornerRadius, hasStroke, strokeColor)
	if cornerRadius then
		local corner = inst:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, cornerRadius)
		corner.Parent = inst
	end
	if hasStroke then
		local stroke = nil
		for _, s in ipairs(inst:GetChildren()) do
			if s:IsA("UIStroke") and s.ApplyStrokeMode == Enum.ApplyStrokeMode.Border then
				stroke = s
				break
			end
		end
		if not stroke then
			stroke = Instance.new("UIStroke")
			stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			stroke.Parent = inst
		end
		stroke.Color = strokeColor or STYLES.StrokeColor
		stroke.Thickness = 1
	end
end

local function createStyledBtn(text, parent, height, strokeColor)
