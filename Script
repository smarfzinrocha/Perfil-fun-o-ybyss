local function updateGuiTheme()
	for _, desc in ipairs(page:GetDescendants()) do
		if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
			desc.TextColor3 = STYLES.TextColor
			desc.Font = currentFont

			local textStroke, borderStroke = nil, nil
			for _, child in ipairs(desc:GetChildren()) do
				if child:IsA("UIStroke") then
					if child.ApplyStrokeMode == Enum.ApplyStrokeMode.Contextual then
						textStroke = child
					elseif child.ApplyStrokeMode == Enum.ApplyStrokeMode.Border then
						borderStroke = child
					end
				end
			end

			if textStrokeEnabled and currentStrokeThick > 0 then
				if not textStroke then
					textStroke = Instance.new("UIStroke")
					textStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
					textStroke.Parent = desc
				end
				textStroke.Color = STYLES.StrokeColor
				textStroke.Thickness = currentStrokeThick
				textStroke.Transparency = 0.15
			else
				if textStroke then textStroke:Destroy() end
			end

			if borderStroke then
				borderStroke.Color = STYLES.StrokeColor
			end
		elseif desc:IsA("UIStroke") and desc.ApplyStrokeMode == Enum.ApplyStrokeMode.Border then
			desc.Color = STYLES.StrokeColor
		elseif desc:IsA("ScrollingFrame") then
			desc.ScrollBarImageColor3 = STYLES.StrokeColor
		end
	end
end

